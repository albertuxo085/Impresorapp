<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <runtime>
    <!-- Mejoras de accesibilidad de Windows Forms (.NET Framework 4.7.1-4.8): roles correctos para lectores de pantalla, foco visible y navegación con teclado. -->
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=false;Switch.UseLegacyAccessibilityFeatures.2=false;Switch.UseLegacyAccessibilityFeatures.3=false;Switch.UseLegacyAccessibilityFeatures.4=false;Switch.System.Windows.Forms.UseLegacyToolTipDisplay=false" />
  </runtime>
</configuration>
